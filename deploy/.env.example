# Copiez ce fichier en « .env » (sur le serveur uniquement) et remplissez-le.
# ⚠ Ne partagez jamais ce fichier : il contient les mots de passe.

# Votre nom de domaine (sans https://), ex. tunisiagoldenleague.tn
DOMAIN=
# E-mail pour le certificat HTTPS (Let's Encrypt)
ACME_EMAIL=

# Mot de passe de la base (lettres et chiffres seulement) : openssl rand -hex 24
POSTGRES_PASSWORD=
# Clé secrète des connexions (64 caractères) : openssl rand -hex 32
JWT_SECRET=

# Envoi des e-mails (code d'activation, mot de passe oublié) — Gmail :
# SMTP_PASS = « mot de passe d'application » Google (16 lettres), PAS le mot de passe du compte
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Notifications : expo.dev → Account settings → Access tokens → créer un jeton,
# puis activer « Enhanced Security for Push Notifications » dans le projet (seul ce serveur pourra envoyer)
EXPO_ACCESS_TOKEN=
